# API
API_PORT=3001
SESSION_SECRET=uzun-rastgele-bir-gizli-anahtar-degistirin
SESSION_TTL_DAYS=7

# Google Sheet (DB)
GOOGLE_SHEET_ID=your_spreadsheet_id

# Service account — dosya yolu (önerilen)
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json

# Sheet: Editor paylaşımı gerekir (admin yazmaları için).
# Drive klasörleri: okuma için Viewer yeterli; diyagram Kaydet için Editor gerekir.

# Opsiyonel: yalnızca bu kök klasörün altındaki klasörleri listele
# GOOGLE_DRIVE_ROOT_FOLDER_ID=1abc...

# veya doğrudan env (FILE yoksa):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=...@....iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
